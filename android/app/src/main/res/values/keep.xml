<?xml version="1.0" encoding="utf-8"?>
<!--
  VoraTube release-build resource keep rules.

  The media-notification icons below are referenced by *string* resource name
  at runtime (AudioServiceConfig.androidNotificationIcon and the
  MediaControl.custom androidIcon names in JustAudioController), never through
  a static R.drawable reference. The release build enables resource shrinking
  (isShrinkResources = true), whose static analysis cannot see string-based
  references — so without this file the shrinker strips the drawables and the
  release build posts a notification with a missing/invalid small icon, which
  Android drops silently (notification disappears in release while debug,
  where shrinking is off, keeps working).

  Listing them here with tools:keep is the smallest correct fix: shrinking
  stays enabled for everything else.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_vora,@drawable/ic_favorite_on,@drawable/ic_favorite_off,@drawable/ic_close" />
