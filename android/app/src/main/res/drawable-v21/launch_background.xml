<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- VoraTube brand near-black (matches AppColors.voidBlack). Using the
         brand backdrop instead of the default background prevents a bright
         flash between the OS launch window and the custom animated splash. -->
    <item>
        <shape>
            <solid android:color="#FF09090B" />
        </shape>
    </item>

